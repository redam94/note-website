# Combined: FastAPI backend + Next.js frontend in one container
# Backend on :8080 internally, Next.js on :3000, proxies /api/* to backend

# ── Stage 1: Build frontend ──────────────────────────────────────────
FROM node:20-alpine AS frontend-builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY src/ src/
COPY public/ public/
COPY next.config.ts tsconfig.json postcss.config.mjs eslint.config.mjs ./
# next-env.d.ts is generated by Next.js during build

ENV BACKEND_URL=http://localhost:8080
RUN npm run build

# ── Stage 2: Runtime ─────────────────────────────────────────────────
FROM python:3.11-slim

# Install Node.js + curl + git (git needed for GitHub wiki sync)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Backend Python deps
WORKDIR /app/backend
COPY backend/pyproject.toml .
RUN pip install --no-cache-dir .

# Backend code
COPY backend/app/ app/
COPY backend/alembic/ alembic/
COPY backend/alembic.ini .

# Frontend standalone build
WORKDIR /app/frontend
COPY --from=frontend-builder /app/.next/standalone ./
COPY --from=frontend-builder /app/.next/static ./.next/static
COPY --from=frontend-builder /app/public ./public

# Startup script
WORKDIR /app
COPY run.sh .
RUN chmod +x run.sh

ENV DATABASE_URL=/data/knowledge.db
ENV UPLOADS_DIR=/data/uploads
ENV USE_REDIS=false
ENV CORS_ORIGINS=["*"]
ENV PORT=3000

EXPOSE 3000

CMD ["./run.sh"]
